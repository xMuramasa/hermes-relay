[Unit]
Description=Trismegistus agents helper (lists, follows and stops Hermes background work for the relay)

[Service]
# The socket lives in a directory that survives reboots: the relay container bind-mounts it, and a mount source
# under /run/user (emptied at boot) would be created by Docker as root if the relay started first.
ExecStart=%h/.local/bin/trismegistus-agents -socket %h/.local/state/trismegistus-agents/agents.sock -runs %h/.local/state/hermes-runs,%h/.hermes/cache/scratch/tmac/wt
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
